SELECT * FROM compra;


/*READ */ consultar dados

Ver todos os clientes

SELECT * FROM cliente;

Ver todos os produtos

SELECT * FROM produto;

Ver compras

SELECT * FROM compra;

/*UPDATE */ atualizar

UPDATE cliente
SET telefone = '19996583159'
WHERE id_cliente = 1;


/*DELETE */ excluir

DELETE FROM compra
WHERE id_compra = 1;
